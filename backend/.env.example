# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL (XAMPP defaults - root user, no password, phpMyAdmin runs on port 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cooperative_db
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Paystack (get keys from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
